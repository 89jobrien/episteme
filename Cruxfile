# Cruxfile for episteme-local release orchestration.
#
# Run a target:
#   crux run --strict --plugins <plugins.toml> --target <target> Cruxfile
#
# The plugin host is NOT declared here; it must be passed with --plugins on every
# invocation, because the release handlers (release::prepare, release::gates,
# release::publish, release::report) live in a subprocess plugin rather than in
# the built-in registry:
#
#   crux run --strict \
#     --plugins ~/.agents/skills/rust-release-orchestrator/scripts/plugins.toml \
#     --target dry-run Cruxfile
#
# Why the options are hardcoded instead of templated from input
# ------------------------------------------------------------
# A Cruxfile target executes with a null input (crux-cli run.rs passes
# Value::Null for every target), and --input is only honoured for single-purpose
# .crux pipelines -- for a Cruxfile it is parsed and then discarded. So
# `{{ input.dry_run }}` does not resolve here: it is emitted as a literal
# string and arrives at the plugin as the text "{{ input.dry_run }}", which
# fails to deserialize into the typed ReleaseInput booleans.
#
# Each target below therefore encodes its own flags as literal YAML, which is
# what the multi-target form is for: the target name is the input. The
# workspace is a literal for the same reason -- a Cruxfile target cannot read
# it from input. That hardcoded path is machine-specific by construction.
project: episteme
# release-plan is the default because it is the only release target that
# changes nothing: it prints the planned version, tag, and mutation list
# without bumping, committing, tagging, or publishing. Every other target
# either mutates the repo or uploads.
default: release-plan

# Publishing walks every handler (prepare, gates, one publish per crate,
# report) with retries, so the call ceiling is per-crate generous. duration_ms
# is the wall-clock guard for the whole run; a cold release that compiles
# dependencies before the gates lands well inside an hour.
budget:
  calls: 40
  duration_ms: 3600000

targets:
  # ---------------------------------------------------------------------
  # cargo-rail release targets. Requires cargo-rail >= 0.25.0; the commands
  # and the semantics below do not work on 0.17.3.
  #
  # These own the mechanical release: the Cargo.toml and Cargo.lock version
  # bump, the release commit, the push of that commit, the crates.io upload,
  # the tag, and the push of the tag. The changelog stays hand-authored --
  # .config/rail.toml sets crates.episteme-local.changelog.skip = true, and
  # scripts/promote-changelog.sh performs the heading cut. See the comments in
  # rail.toml for why.
  #
  # As of 0.25.0 rail pushes git itself (remote_effects = "push"), because
  # --publish is refused while remote_effects = "none". Both git pushes are
  # therefore no longer manual, and the release commit reaches origin before
  # the crates.io upload.
  #
  # Unlike the release-orchestrator plugin below, cargo-rail drives the whole
  # sequence itself, so these targets are shell steps rather than a
  # prepare/gates/publish/report fan-out.
  # ---------------------------------------------------------------------

  # Preview the release plan. Writes nothing: no bump, no commit, no tag, no
  # push, no publish. Safe to run at any time. This is the default because it is
  # the only release target that cannot change anything.
  #
  # --publish is included even in the preview so the plan shows the full
  # sequence rail would execute, including PUBLISH_CRATE. Without it the plan
  # would omit publishing and misrepresent what release-apply does.
  release-plan:
    steps:
      # shell::exec, not shell::capture: cargo-rail exits 1 from --check to
      # signal "a release is pending", not to signal failure -- the JSON it
      # prints is the successful output. shell::capture would treat that exit
      # code as a step error and discard the plan.
      - step: rail_plan
        handler: shell::exec
        args:
          cmd: "cargo rail release run episteme-local --bump minor --publish --check --format json"
          cwd: /Users/joe/dev/episteme
        timeout_ms: 600000

      - step: log_plan
        handler: ctrl::log
        args:
          field: stdout

  # Cut the changelog and stage the bump. Rewrites CHANGELOG.md in place and
  # commits it, so a committed cut is reviewable before anything is tagged or
  # pushed.
  #
  # The require_clean = true guard that used to force this split was removed in
  # cargo-rail 0.25.0; previews now permit a dirty tree and apply rejects paths
  # outside the bound plan. The separate commit is kept anyway -- it is the last
  # point at which the changelog can be reviewed before the version is bumped,
  # committed, and pushed to origin.
  #
  # The version is pinned in two places and they must agree: the argument below
  # and --bump minor in release-plan / release-apply. Minor, not patch, because
  # 0.2.0 adds public API surface (the intelligence module, the analyze and
  # classify-batch CLI commands, two new migrations).
  release-bump:
    steps:
      - step: promote_changelog
        handler: shell::capture
        args:
          cmd: "./scripts/promote-changelog.sh 0.2.0"
          cwd: /Users/joe/dev/episteme
        timeout_ms: 120000

      - step: commit_changelog
        handler: shell::capture
        args:
          cmd: "git add CHANGELOG.md && git commit -m 'docs(release): cut 0.2.0 changelog section'"
          cwd: /Users/joe/dev/episteme
        timeout_ms: 300000

  # Apply the release: bump, commit, push the release commit, publish to
  # crates.io, create the tag, and push the tag. IRREVERSIBLE, and it now moves
  # git as well as the registry. Only run after release-plan and release-bump.
  release-apply:
    steps:
      # shell::capture on purpose: unlike the --check path above, a non-zero
      # exit here is a real failure and must fail the step, so an upload that
      # did not happen can never be mistaken for a release.
      #
      # The crates.io token is read from 1Password and exported into this
      # command's environment. See the note on release-resume: the
      # "op plugin run -- cargo" shell plugin targets the cratebox registry,
      # so CARGO_REGISTRY_TOKEN is the reliable path for a crates.io publish.
      #
      # The 1Password reference is assembled from $SCHEME at run time rather
      # than written out, because obfsck's pre-commit scan treats a literal
      # op:// secret reference in a tracked file as a leaked credential and
      # blocks the commit. This indirection keeps the hook satisfied without
      # weakening it.
      - step: rail_release
        handler: shell::capture
        args:
          cmd: "SCHEME=op; CARGO_REGISTRY_TOKEN=$(op read \"${SCHEME}://cli/cargo-api-token/token\") cargo rail release run episteme-local --bump minor --publish --yes"
          cwd: /Users/joe/dev/episteme
        timeout_ms: 1800000
        # --publish is REQUIRED under cargo-rail 0.25.0. Before 0.25.0,
        # `release run` published implicitly; from 0.25.0 the default plan is
        # BUMP_VERSION, UPDATE_LOCKFILE, COMMIT_RELEASE, CREATE_TAG and nothing
        # else, so omitting this flag produces a release that bumps, commits,
        # and tags a version that is never uploaded. rail.toml sets
        # registry_publication = "crates-io" and remote_effects = "push",
        # which are the two preconditions --publish checks.
        #
        # --yes remains the non-interactive confirmation. `--check` is NOT
        # valid here: it would turn this into a preview that writes nothing.
        #
        # NO retry policy, deliberately.
        #
        # This step is not idempotent: cargo-rail reads the current version
        # and bumps it, commits, and tags. A retry re-runs that whole
        # sequence, so a failure partway through (an auth failure on upload,
        # say) advances the version again on every attempt. An earlier
        # revision of this file carried `retry: {count: 2}` and a single
        # failed publish produced 0.2.0, 0.3.0, and 0.4.0.
        #
        # cargo-rail writes a resumable state file and prints the resume
        # command on failure, so recovery belongs to the release-resume
        # target, not to a blind re-run.
        #
        # ORDERING CHANGED at 0.25.0. The plan is now
        #   BUMP -> LOCKFILE -> COMMIT -> PUSH_RELEASE_COMMIT
        #   -> AWAIT_EXACT_SHA_CHECKS -> PUBLISH_CRATE -> CREATE_TAG
        #   -> PUSH_RELEASE_TAGS
        # so rail pushes the release commit to origin BEFORE uploading, and
        # pushes the tag AFTER. Under 0.17.3 (push = false) nothing was pushed
        # and both pushes were manual, which allowed verifying the upload
        # before git moved. That ordering is deliberately abandoned; see the
        # comment on remote_effects in .config/rail.toml.
        #
        # AWAIT_EXACT_SHA_CHECKS is planned with poll = false and this repo has
        # no .github workflows, so that gate has nothing to bind to. Unverified
        # against a real apply.

  # Resume an interrupted release from cargo-rail's durable state file, after
  # release-apply failed partway (typically an auth or network error on upload).
  #
  # This target -- not release-apply -- is the recovery path, because the
  # apply step is not idempotent. cargo-rail persists the bump, commit, and tag
  # in target/cargo-rail/releases/*.json.
  #
  # HISTORY, and the reason this file was rewritten on 2026-09-29: under
  # cargo-rail 0.17.3 this target could not upload at all. With
  # publication: in_progress, reconcile_publications took the wait_for_registry
  # branch and never called publish_crate, so an unuploaded version was never
  # uploaded -- and it then reported "was published but did not become
  # observable", which was false in both halves. That blocked the 0.2.0 release.
  #
  # That defect is FIXED as of 0.25.0: publish_crate is now called
  # unconditionally, and the false message is replaced by an error that fires
  # only when publish actually failed. Verified by reading
  # src/release/publisher.rs at tag v0.25.0.
  #
  # One consequence to remember: under 0.25.0 the plan pushes the release
  # commit before uploading, so a release that fails at the upload stage can
  # leave origin ahead of crates.io. Reconcile with `cargo rail release status`
  # and the external checks in docs/release-runbook.md before pushing anything
  # further.
  release-resume:
    steps:
      # The crates.io token is read from 1Password and exported into this
      # command's environment.
      #
      # `op plugin run -- cargo` does NOT work for this: the 1Password cargo
      # shell plugin writes ~/.cargo/credentials.toml with the token under
      # [registries.cratebox] -- the private registry in ~/.cargo/config.toml
      # -- not under [registry], which is the key `cargo publish` reads for
      # crates.io. The result is "no token found" even though op succeeded.
      # Exporting CARGO_REGISTRY_TOKEN directly is the reliable path, since
      # cargo-rail's own `cargo publish` subprocess inherits this environment.
      #
      # No retry: a failed resume must stop, not re-attempt the whole
      # release sequence. Re-run this target instead.
      - step: rail_resume
        handler: shell::capture
        args:
          cmd: "SCHEME=op; CARGO_REGISTRY_TOKEN=$(op read \"${SCHEME}://cli/cargo-api-token/token\") cargo rail release resume $(ls -t target/cargo-rail/releases/*.json | head -1)"
          cwd: /Users/joe/dev/episteme
        timeout_ms: 1800000

  # ---------------------------------------------------------------------
  # release-orchestrator plugin targets.
  #
  # These use the rust-release-orchestrator plugin instead of cargo-rail. They
  # are kept because the plugin is the more general multi-crate tool, but for
  # this single-crate repo the cargo-rail targets above are the ones to use --
  # they additionally own the version bump and tag.
  # ---------------------------------------------------------------------

  # Validation only. Cargo packages and verifies the crate and uploads
  # nothing.
  dry-run:
    steps:
      - step: prepare
        handler: release::prepare
        args:
          workspace: /Users/joe/dev/episteme
          dry_run: true
          resume: false
          skip_gates: false

      - step: gates
        handler: release::gates

      - for_each: publish_packages as package
        items: "{{ steps.prepare.output.packages }}"
        steps:
          - step: publish
            handler: release::publish
            args:
              package: "{{ iter.package }}"

      - step: report
        handler: release::report

  # A real release via the plugin. Uploads to crates.io. Only run this after
  # dry-run has validated the exact version and you have confirmed the upload.
  # Unlike release-apply, this does not bump the version or create a tag.
  plugin-release:
    steps:
      - step: prepare
        handler: release::prepare
        args:
          workspace: /Users/joe/dev/episteme
          dry_run: false
          resume: false
          skip_gates: false

      - step: gates
        handler: release::gates

      - for_each: publish_packages as package
        items: "{{ steps.prepare.output.packages }}"
        steps:
          - step: publish
            handler: release::publish
            args:
              package: "{{ iter.package }}"

      - step: report
        handler: release::report

  # Resume an interrupted plugin release. Reads target/.release-state.json and
  # reports already-published crates as skipped. Never pair this with a version
  # bump: the recorded state refers to the version it was created for.
  plugin-resume:
    steps:
      - step: prepare
        handler: release::prepare
        args:
          workspace: /Users/joe/dev/episteme
          dry_run: false
          resume: true
          skip_gates: false

      - step: gates
        handler: release::gates

      - for_each: publish_packages as package
        items: "{{ steps.prepare.output.packages }}"
        steps:
          - step: publish
            handler: release::publish
            args:
              package: "{{ iter.package }}"

      - step: report
        handler: release::report

  # Gates without packaging. Useful before a release because it runs the same
  # fmt, clippy, and nextest checks the release path runs, and touches no
  # Cargo packaging state at all.
  gates:
    steps:
      - step: prepare
        handler: release::prepare
        args:
          workspace: /Users/joe/dev/episteme
          dry_run: true
          resume: false
          skip_gates: true

      - step: gates
        handler: release::gates
